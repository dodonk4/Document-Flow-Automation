      "parameters": {
        "jsCode": "const out = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const body = items[i].json.body || {};\n  const inv = body.data ?? body;\n  const safe = (s) => String(s ?? '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/[^A-Za-z0-9._-]+/g, '_').replace(/^_+|_+$/g, '').slice(0, 60);\n  const original = $('Filtrar adjuntos PDF').itemMatching(i);\n  out.push({\n    json: {\n      documentId: inv.documentId,\n      invoiceNumber: inv.invoiceNumber,\n      issuerName: inv.issuerName,\n      total: inv.total,\n      driveFileName: `${safe(inv.issuerName) || 'emisor'}_${safe(inv.invoiceNumber) || 'factura'}_${String(inv.documentId).slice(0, 8)}.pdf`,\n    },\n    binary: { data: original.binary.data },\n  });\n}\nreturn out;"
      },
