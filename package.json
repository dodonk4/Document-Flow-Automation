{
  "name": "document-flow-automation",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "migrate:dev": "npx prisma migrate dev",
    "test": "tsx --test test/unit/invoiceParser.test.ts",
    "test:integration": "npx dotenv -e .env.test -- prisma migrate deploy && npx dotenv -e .env.test -- tsx --test test/integration/documents.test.ts",
    "test:db:up": "npx dotenv -e .env.test -- docker compose --profile testing up -d --wait test-db",
    "test:db:down": "npx dotenv -e .env.test -- docker compose --profile testing stop test-db",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "prisma": "^7.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.11.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
